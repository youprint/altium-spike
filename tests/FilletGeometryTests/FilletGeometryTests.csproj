<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>FilletGeometryTests</AssemblyName>
    <RootNamespace>FilletTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    Compiles the plugin's own FilletGeometry.cs rather than a copy, so these
    assertions cannot drift from what ships. That file references no Altium
    type, which is what makes this possible: the tests run anywhere dotnet
    does, with no Altium installation and no SDK assemblies.
  -->
  <ItemGroup>
    <Compile Include="../../FilletGeometry.cs" />
    <Compile Include="Tests.cs" />
  </ItemGroup>

</Project>
