<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SchPlacementTests</AssemblyName>
    <RootNamespace>SchPlacementTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    Compiles the PLUGIN'S OWN SchPlacementPlan.cs rather than a copy, so these
    assertions cannot drift from what ships. SchPlacementPlan.cs references no
    Altium type, so this runs anywhere dotnet does.

    Exit code is 0 when every assertion passes, 1 otherwise.
  -->
  <ItemGroup>
    <Compile Include="../../SchPlacementPlan.cs" />
    <Compile Include="Tests.cs" />
  </ItemGroup>

</Project>
