<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>FenceGeometryTests</AssemblyName>
    <RootNamespace>FenceTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    Compiles the PLUGIN'S OWN FenceGeometry.cs rather than a copy, so these
    assertions cannot drift from what ships. FenceGeometry.cs deliberately
    references no Altium type, which is what makes this possible: the tests
    run anywhere dotnet does, with no Altium installation and no SDK DLLs.

    Run it from the repository root with dotnet run, pointing at this
    directory. Exit code is 0 when every assertion passes, 1 otherwise.
  -->
  <ItemGroup>
    <Compile Include="../../FenceGeometry.cs" />
    <Compile Include="Tests.cs" />
  </ItemGroup>

</Project>
